# ========================================================================
# Ghorob Chams Residence (إقامة غروب شمس) - Environment Variables
# Copy this file to .env and adjust values for your environment.
# Never commit .env or private secrets to Git version control.
# ========================================================================

# ------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------
# [اختياري - Optional] Port for the Node.js / Express server (default: 3000)
PORT=3000

# [اختياري - Optional] Environment mode: 'development' or 'production' (default: production)
NODE_ENV=production

# [اختياري - Optional] The public canonical URL where the website is hosted (used for sitemap.xml & metadata)
# Example: https://ghorob-chams-residence.ma or https://your-app.onrender.com
APP_URL=https://ghorob-chams-residence.ma

# ------------------------------------------------------------------------
# 2. Database Configuration (DATABASE_URL)
# ------------------------------------------------------------------------
# [اختياري تماماً - 100% OPTIONAL]
# If left EMPTY or omitted, the application operates at ZERO COST using the built-in
# persistent JSON store located at data/database.json.
# No PostgreSQL instance or paid database service is required to run the site or admin portal!
# If you later decide to connect an external PostgreSQL database (e.g., Neon, Supabase, Render Postgres):
# Example: postgresql://user:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------
# 3. Administrator Authentication & Security
# ------------------------------------------------------------------------
# [اختياري - Optional] Administrator username for the Owner Portal (default: owner)
ADMIN_USERNAME=owner

# [موصى به بشدة - Highly Recommended] Administrator password for the Owner Portal (/admin)
# If left empty, defaults safely to 'GhorobChams2026!'.
# Set this to your own custom strong password for production.
ADMIN_PASSWORD=your_custom_secure_password_here

# [اختياري ولكن موصى به - Recommended for Production]
# Secret salt used for HMAC-SHA256 password hashing and token validation.
# If omitted, defaults safely to an internal salt ('ghorob_chams_salt_2026') without crashing.
# For high security, generate a 32+ character random string (e.g., `openssl rand -hex 32`).
ADMIN_SECRET_KEY=generate_a_random_32_character_secret_key_here

# ------------------------------------------------------------------------
# 4. Decoupled Frontend & CORS (Only needed if hosting frontend & backend separately)
# ------------------------------------------------------------------------
# [اختياري تماماً - 100% OPTIONAL]
# When deploying as a unified full-stack application (frontend + backend together on Render, Railway, or VPS):
# LEAVE VITE_API_BASE_URL EMPTY! The frontend will use relative paths (/api/...) directly.
# Only set VITE_API_BASE_URL if you host the static frontend on Cloudflare Pages / Netlify / Vercel
# and the Node.js backend on a different domain (e.g., https://api.yourdomain.com).
VITE_API_BASE_URL=

# [اختياري - Optional] Allowed frontend origins for CORS.
# Defaults to '*' (permits all origins) if left empty or omitted.
# Example: https://ghorob-chams.pages.dev,https://ghorobchams.com
CORS_ORIGIN=*
